# 数据库
DATABASE_URL=sqlite:///./opc_brain.db

# AI 大模型配置（支持 OpenAI / DeepSeek / 通义千问 等）
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 向量数据库
VECTOR_STORE_PATH=./vector_store

# 电商平台 API 配置
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
XIAOHONGSHU_CLIENT_ID=
XIAOHONGSHU_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 文件存储
UPLOAD_DIR=./uploads
